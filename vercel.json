{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm -C packages/remote-web build",
  "outputDirectory": "packages/remote-web/dist",
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://vibe-kanban-api-khanhle43.onrender.com/v1/:path*"
    },
    {
      "source": "/((?!assets/|v1/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
